<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build against Maven Central over HTTPS.

  Use this when the machine's global ~/.m2/settings.xml points at an internal
  mirror that does not carry these artifacts (or serves them over plain HTTP,
  which Maven 3.9 blocks by default):

      mvn -s settings-central.xml package

  It deliberately keeps the default local repository, so anything already
  cached in ~/.m2/repository is reused.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <profiles>
    <profile>
      <id>central-https</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>central-https</activeProfile>
  </activeProfiles>
</settings>
